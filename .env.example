# Used by docker-compose and by the backend when run directly
DB_URL=jdbc:mysql://localhost:3306/mini_ats?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USER=root
DB_PASS=change_me
CORS_ORIGIN=http://localhost:5173

# Login. The first start creates this admin if no users exist yet.
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
ADMIN_EMAIL=admin@miniats.com
ADMIN_PASSWORD=change_me_now

# Baked into the frontend image at build time
VITE_API_URL=http://localhost:8080/api/v1
